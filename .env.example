# Groww engine safety defaults
TRADING_MODE=PAPER
ENABLE_LIVE_ORDERS=false
I_UNDERSTAND_LIVE_ORDER_RISK=NO

# Groww credentials (set in cloud secrets, never commit real values)
GROWW_API_KEY=your_api_key_here
GROWW_API_SECRET=your_api_secret_here
GROWW_ACCESS_TOKEN=your_access_token_here

# Trading runtime
TRADING_TIMEZONE=Asia/Kolkata
POLL_SECONDS=15
UNDERLYING_SYMBOL=NIFTY
GROWW_INSTRUMENT_TYPE=FNO

# Storage and logs
PAPER_SQLITE_PATH=outputs/groww/paper_trades.db
PAPER_CSV_PATH=outputs/groww/paper_trades.csv
GROWW_LOGS_DIR=outputs/groww/logs

# Risk controls
MAX_QUANTITY_PER_TRADE=200
MAX_TRADES_PER_DAY=10
MAX_OPEN_POSITIONS=3
MAX_DAILY_LOSS=5000
MAX_LOSS_PER_TRADE=1500
TRADING_START_TIME=09:16
NEW_ENTRY_CUTOFF_TIME=15:10
MANDATORY_SQUARE_OFF_TIME=15:20
COOLDOWN_SECONDS=120
DUPLICATE_SIGNAL_WINDOW_SECONDS=180
ONE_POSITION_PER_SYMBOL=true
CONSECUTIVE_LOSS_LIMIT=3
EMERGENCY_KILL_SWITCH=false
MAX_MARKET_DATA_STALENESS_SECONDS=30
MAX_API_FAILURES_BEFORE_HALT=3

# Paper cost assumptions
BROKERAGE_PER_ORDER=20
TAX_RATE=0.0005
SLIPPAGE_BPS=2
